{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "lavarapido",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "firestore.*",
        "**/.*",
        "**/node_modules/**",
        "testes/**",
        "supabase/**",
        "docs/**",
        "README.md",
        "LICENSE"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "lava-rapido-enzo",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "firestore.*",
        "**/.*",
        "**/node_modules/**",
        "testes/**",
        "supabase/**",
        "docs/**",
        "README.md",
        "LICENSE"
      ],
      "redirects": [
        {
          "source": "/c/",
          "destination": "https://lavarapido.web.app/c/",
          "type": 301
        },
        {
          "source": "**",
          "destination": "https://lavarapido.web.app/",
          "type": 301
        }
      ]
    },
    {
      "site": "agaragemz",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "firestore.*",
        "**/.*",
        "**/node_modules/**",
        "testes/**",
        "supabase/**",
        "docs/**",
        "README.md",
        "LICENSE"
      ],
      "redirects": [
        {
          "source": "/c/",
          "destination": "https://lavarapido.web.app/c/",
          "type": 301
        },
        {
          "source": "**",
          "destination": "https://lavarapido.web.app/",
          "type": 301
        }
      ]
    },
    {
      "site": "lava-rapido-garagemz",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "firestore.*",
        "**/.*",
        "**/node_modules/**",
        "testes/**",
        "supabase/**",
        "docs/**",
        "README.md",
        "LICENSE"
      ],
      "redirects": [
        {
          "source": "/c/",
          "destination": "https://lavarapido.web.app/c/",
          "type": 301
        },
        {
          "source": "**",
          "destination": "https://lavarapido.web.app/",
          "type": 301
        }
      ]
    }
  ]
}
