{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "firestore.*", "**/.*", "**/node_modules/**", "testes/**", "supabase/**", "docs/**", "README.md", "LICENSE"],
    "headers": [
      { "source": "**/*.@(js|css|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store" }] }
    ]
  }
}
